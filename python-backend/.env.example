# Provider integration setup
# Configure only on the backend (never use VITE_ variables for secrets).
CRICKET_API_BASE_URL=
CRICKET_API_KEY=
CRICKET_API_KEY_HEADER=x-api-key
# Optional query parameter auth name; leave empty for header auth.
CRICKET_API_KEY_QUERY=
# Set these to paths supported by your provider.
CRICKET_API_LIVE_PATH=/matches/live
CRICKET_API_HISTORY_PATH=/matches
CRICKET_API_MATCH_DETAIL_PATH=/matches/{match_id}
CRICKET_CACHE_TTL=45
