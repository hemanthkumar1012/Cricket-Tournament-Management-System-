# Local development. SQLite is suitable only for local testing.
DATABASE_URL=sqlite:///./cricket_app.db

# Change both credentials before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploy
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Comma-separated allowed browser origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Live-score HTML fallback. It is experimental and can change when the source site changes.
